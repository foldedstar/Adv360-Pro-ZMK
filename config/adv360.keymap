#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

#define MC_HASH LA(N3)
#define SC_FLL LC(LA(RET))
#define SC_LFT LC(LA(LEFT))
#define SC_RGT LC(LA(RIGHT))

#define KEYS_LEFT 0 1 2 3 4 5 6 \
                  14 15 16 17 18 19 20 \
                  28 29 30 31 32 33 34 \
                  46 47 48 49 50 51 \
                  66 67 68 69 70

#define KEYS_RIGHT 7 8 9 10 11 12 13 \
                   21 22 23 24 25 26 27 \
                   39 40 41 42 43 44 45 \
                   60 61 62 63 64 65 \
                   77 78 79 80 81

#define THUMBS_LEFT 35 36 54 71 72 73
#define THUMBS_RIGHT 37 38 57 74 75 76
#define THUMBS THUMBS_LEFT THUMBS_RIGHT

&caps_word {
    continue-list = <UNDERSCORE MINUS BACKSPACE DELETE>;
};

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

    tlm: thumb_layer_mods {
        compatible = "zmk,behavior-hold-tap";
        label = "THUMB_LAYER_MODS";
        #binding-cells = <2>;
        flavor = "balanced";
        tapping-term-ms = <200>;
        quick_tap_ms = <175>;
        bindings = <&mo>, <&kp>;
    };

    hml: homerow_mods_left {
        compatible = "zmk,behavior-hold-tap";
        label = "HOMEROW_MODS_LEFT";
        #binding-cells = <2>;
        flavor = "balanced";
        tapping-term-ms = <200>;
        quick_tap_ms = <175>;
        hold-trigger-key-positions = <KEYS_RIGHT THUMBS>;
        bindings = <&kp>, <&kp>;
    };

    hmr: homerow_mods_right {
        compatible = "zmk,behavior-hold-tap";
        label = "HOMEROW_MODS_RIGHT";
        #binding-cells = <2>;
        flavor = "balanced";
        tapping-term-ms = <200>;
        quick_tap_ms = <175>;
        hold-trigger-key-positions = <KEYS_LEFT THUMBS>;
        bindings = <&kp>, <&kp>;
    };
    tmr: thumbrow_mods {
        compatible = "zmk,behavior-hold-tap";
        label = "THUMBROW_MODS";
        #binding-cells = <2>;
        flavor = "balanced";
        tapping-term-ms = <200>;
        quick_tap_ms = <175>;
        bindings = <&kp>, <&kp>;
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    macros {
        mc_sw: mc_sw {
            label = "MAC_SWITCH";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&bt BT_SEL 0>
                , <&to 1>
                ; // enable mac overlay layer
        };
        pc_sw: pc_sw {
            label = "PC_SWITCH";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&bt BT_SEL 1>
                , <&to 0>
                ; // disable mac overlay layer
        };
    };
    extra1 {
      display-name = "Red";
      status = "reserved";
    };

    extra2 {
      display-name = "Purple";
      status = "reserved";
    };

    extra3 {
      display-name = "Cyan";
      status = "reserved";
    };

    extra4 {
      display-name = "Yellow";
      status = "reserved";
    };
  };

    keymap {
        compatible = "zmk,keymap";

layer_0 {
  bindings = <
    &mo 6      &kp F1     &kp F2      &kp F3      &kp F4      &kp F5     &kp F6                                                             &kp F7      &kp F8       &kp F9      &kp F10     &kp F11    &kp F12       &mo 6
    &caps_word &kp Q      &kp W       &kp E       &kp R       &kp T      &tog 1                                                             &none       &kp Y        &kp U       &kp I       &kp O      &kp P         &kp CAPS
    &kp ESC   &hml LALT A &hml LGUI S &hml LCTRL D &hml LSHFT F &kp G    &tog 5          &kp F4     &kp F5      &kp LC(X)   &kp F12         &mo 5       &kp H   &hmr RSHFT J &hmr RCTRL K &hmr RGUI L &hmr RALT SEMI &kp RET
    &kp LSHFT  &kp Z      &kp X       &kp C       &kp V       &kp B                                 &kp LC(Z)   &kp LC(C)                                  &kp N        &kp M       &kp COMMA   &kp DOT    &kp FSLH      &kp RSHFT
    &none      &none      &none       &kp LEFT    &kp RIGHT              &tlm 2 BSPC &tmr LCTRL DEL &kp LC(LS(Z)) &kp LC(V)   &tlm 5 TAB  &tlm 4 SPACE           &kp DOWN    &kp UP      &none      &none         &none
 >;
};
layer_1 {
  bindings = <
    &trans     &trans     &trans      &trans      &trans      &trans     &trans                                                        &trans      &trans       &trans      &trans      &trans     &trans        &trans
    &trans     &trans     &trans      &trans      &trans      &trans     &trans                                                        &trans      &trans       &trans      &trans      &trans     &trans        &trans
    &trans     &trans   &hml LCTRL S &hml LGUI D  &trans      &trans     &trans          &trans     &trans   &kp LG(X)  &trans         &trans      &trans       &trans    &hmr RGUI K &hmr RCTRL L &trans        &trans
    &trans     &trans     &trans      &trans      &trans      &trans                                &kp LG(Z)  &kp LG(C)                           &trans       &trans      &trans      &trans     &trans        &trans
    &trans     &trans     &trans      &trans      &trans                     &trans   &tmr LGUI DEL &kp LG(LS(Z)) &kp LG(V)  &trans    &trans                   &trans      &trans      &trans     &trans        &trans
  >;
};
layer_2 {
  bindings = <
    &trans     &none      &none       &none       &none       &none      &trans                                                      &trans   &none     &none       &none       &none      &none         &trans
    &trans     &none      &none       &kp EXCL    &kp SQT     &kp GRAVE  &trans                                                      &trans   &kp PRCNT &kp MINUS   &kp UNDER   &kp LBRC   &kp RBRC      &trans
    &trans     &kp AT     &kp NUHS    &kp QMARK   &kp DQT     &kp TILDE2 &trans          &trans     &trans   &trans  &trans          &trans   &kp STAR  &kp PLUS    &kp EQUAL   &kp LPAR   &kp RPAR      &trans
    &trans     &none      &kp NUBS    &kp POUND   &kp DLLR    &kp CARET                             &trans   &trans                           &none     &kp PIPE2   &kp AMPS    &kp LBKT   &kp RBKT      &trans
    &none      &none      &none       &none       &none                      &trans      &trans     &trans   &trans  &trans    &trans                   &none       &none       &none      &none         &none
  >;
};
layer_3 {
  bindings = <
    &trans     &none      &none       &none       &none       &none      &trans                                                      &trans   &none     &none       &none       &none      &none         &trans
    &trans     &none      &none       &kp EXCL    &kp SQT     &kp GRAVE  &trans                                                      &trans   &kp PRCNT &kp MINUS   &kp UNDER   &kp LBRC   &kp RBRC      &trans
    &trans     &kp AT     &kp MC_HASH &kp QMARK   &kp DQT     &kp TILDE2 &trans          &kp LCTRL  &trans   &trans  &trans          &trans   &kp STAR  &kp PLUS    &kp EQUAL   &kp LPAR   &kp RPAR      &trans
    &trans     &none      &kp NUBS    &kp POUND   &kp DLLR    &kp CARET                             &trans   &trans                           &none     &kp PIPE2   &kp AMPS    &kp LBKT   &kp RBKT      &trans
    &trans     &trans     &none       &none       &none                      &trans      &kp LGUI   &trans   &trans  &trans    &trans                   &none       &none       &none      &trans        &trans
  >;
};
layer_4 {
  bindings = <
    &trans     &none      &none       &none       &none       &none      &trans                                                      &trans   &none     &none       &none       &none      &none         &trans
    &trans     &kp LPAR   &kp RPAR    &kp FSLH    &kp STAR    &none      &trans                                                      &trans   &none     &kp N7      &kp N8      &kp N9     &kp MINUS     &trans
    &trans     &none      &none       &kp MINUS   &kp PLUS    &none      &trans          &trans     &trans   &trans  &trans          &trans   &none     &kp N4      &kp N5      &kp N6     &kp PLUS      &trans
    &trans     &none      &none       &none       &kp EQUAL   &none                                 &trans   &trans                           &kp N0    &kp N1      &kp N2      &kp N3     &kp ENTER     &trans
    &none      &none      &none       &none       &none                      &trans      &trans     &trans   &trans  &trans    &trans                   &kp DOT     &none       &none      &none         &none
  >;
};
layer_5 {
  bindings = <
    &trans     &none      &none       &none          &none         &none            &trans                                                    &trans   &none     &none       &none       &none      &none        &trans
    &trans     &none      &none     &mmv MOVE_UP     &none         &none            &trans                                                    &trans   &none     &none       &none       &none      &none        &trans
    &trans     &none &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &msc SCRL_UP     &trans       &trans     &trans   &trans  &trans           &trans  &kp LEFT  &kp DOWN    &kp UP      &kp RIGHT  &none         &trans
    &trans     &none      &none       &none          &none         &msc SCRL_DOWN                           &trans   &trans                           &kp HOME  &kp PG_DN   &kp PG_UP   &kp END    &none         &trans
    &trans     &none      &none       &none          &none                           &mkp LCLK   &mkp RCLK  &trans   &trans  &trans    &trans                   &none       &none       &none      &trans        &trans
  >;
};
layer_6 {
  bindings = <
    &trans     &mc_sw     &pc_sw     &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bootloader                                     &bootloader         &none     &none       &none       &none      &none         &trans
    &none      &none      &kp C_VOL_DN &kp C_MUTE  &kp C_VOL_UP &none       &none                                            &none              &none     &none       &none       &none      &none         &none
    &none      &none      &kp C_PREV   &kp C_PP    &kp C_NEXT   &none       &none      &none &none &bt BT_CLR &none     &rgb_ug RGB_MEFS_CMD 5  &none     &none       &none       &none      &none         &none
    &none      &none      &none        &none       &none        &none                       &none &none                                         &none     &none       &none       &none      &none         &none
    &none      &none      &none      &kp C_BRI_DN  &kp C_BRI_UP                 &none &none &none &none &bl BL_TOG &rgb_ug RGB_TOG                        &bl BL_INC  &bl BL_DEC  &none      &none         &none
  >;
};

  };
};
